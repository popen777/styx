   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    },
    "colorMode": "background",
    "textMode": "value_and_name",
    "graphMode": "none"
   }
  },
  {
   "id": 8,
   "type": "row",
   "title": "Клиенты",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 9,
   "type": "table",
   "title": "Кто онлайн сейчас",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 11,
    "w": 10,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (user, node, proto) (styx_user_online{user!~\"probe|bridge\"}) > 0",
     "format": "table",
     "instant": true
    }
   ],
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true
      },
      "renameByName": {
       "user": "Пользователь",
       "node": "Нода",
       "proto": "Протокол",
       "Value": "Устройств"
      }
     }
    }
   ],
   "options": {
    "sortBy": [
     {
      "displayName": "Пользователь"
     }
    ]
   }
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Устройства онлайн по пользователям",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 10,
    "y": 11,
    "w": 14,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (user) (styx_user_online{user!~\"probe|bridge\"})",
     "legendFormat": "{{user}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "line",
      "stacking": {
       "mode": "normal"
      },
      "fillOpacity": 30,
      "lineWidth": 1
     },
     "decimals": 0
    },
    "overrides": []
   }
  },
  {
   "id": 11,
   "type": "bargauge",
   "title": "Трафик по пользователям за 24ч",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 10,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sort_desc(sum by (user) (increase(styx_user_traffic_bytes_total{user!~\"probe|bridge\"}[24h])))",
     "legendFormat": "{{user}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "color": {
      "mode": "continuous-BlYlRd"
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "gradient",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Скорость по пользователям (вход+выход)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 10,
    "y": 21,
    "w": 14,
    "h": 10
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (user) (rate(styx_user_traffic_bytes_total{user!~\"probe|bridge\"}[5m])) * 8",
     "legendFormat": "{{user}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps",
     "custom": {
      "fillOpacity": 10
     }
    },
    "overrides": []
   }
  },
  {
   "id": 13,
   "type": "row",
   "title": "Каналы и пробы",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 31,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Задержка RU → US по каналам (observatory)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "styx_outbound_delay_ms{node=\"entry\"} > 0",
     "legendFormat": "{{tag}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "ms"
    },
    "overrides": []
   }
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Время ответа через цепочки",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "probe_duration_seconds{job=\"chain\"}",
     "legendFormat": "{{path}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   }
  },
  {
   "id": 16,
   "type": "row",
   "title": "Серверы",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 40,
    "w": 24,
    "h": 1
   },
   "panels": []
  },
  {
   "id": 17,
   "type": "timeseries",
   "title": "CPU",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 41,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "100 - avg by (node) (rate(node_cpu_seconds_total{mode=\"idle\"}[2m])) * 100",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "max": 100,
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 18,
   "type": "timeseries",
   "title": "RAM",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 8,
    "y": 41,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "(1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes) * 100",
     "legendFormat": "{{node}}"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "max": 100,
     "min": 0
    },
    "overrides": []
   }
  },
  {
   "id": 19,
   "type": "bargauge",
   "title": "Диск /",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 16,
    "y": 41,
    "w": 8,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
     "legendFormat": "{{node}}",
     "instant": true
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "max": 100,
     "min": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 75
       },
       {
        "color": "red",
        "value": 90
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   }
  },
  {
   "id": 20,
   "type": "timeseries",
   "title": "Сеть (основной интерфейс)",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 0,
    "y": 49,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "sum by (node) (rate(node_network_receive_bytes_total{device!~\"lo|docker.*|br-.*|veth.*\"}[2m])) * 8",
     "legendFormat": "{{node}} ↓"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "-sum by (node) (rate(node_network_transmit_bytes_total{device!~\"lo|docker.*|br-.*|veth.*\"}[2m])) * 8",
     "legendFormat": "{{node}} ↑"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "bps"
    },
    "overrides": []
   }
  },
  {
   "id": 21,
   "type": "timeseries",
   "title": "Conntrack / сокеты",
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "gridPos": {
    "x": 12,
    "y": 49,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "A",
     "expr": "node_nf_conntrack_entries",
     "legendFormat": "{{node}} conntrack"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "B",
     "expr": "node_sockstat_TCP_inuse",
     "legendFormat": "{{node}} tcp"
    },
    {
     "datasource": {
      "type": "prometheus",
      "uid": "prometheus"
     },
     "refId": "C",
     "expr": "node_sockstat_UDP_inuse",
     "legendFormat": "{{node}} udp"
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   }
  }
 ],
 "templating": {
  "list": []
 },
 "annotations": {
  "list": []
 }
