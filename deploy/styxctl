def apply_host_local(node_dir):
    run(["install", "-m", "644", str(node_dir / "host" / "sysctl.conf"), "/etc/sysctl.d/99-styx.conf"])
    run(["sysctl", "-q", "--system"], check=False, capture=True)
    run(["nft", "-c", "-f", str(node_dir / "host" / "nftables.nft")])
    run(["install", "-D", "-m", "644", str(node_dir / "host" / "nftables.nft"), "/etc/nftables.d/styx.nft"])
    run(["nft", "-f", "/etc/nftables.d/styx.nft"])


def remote_host_apply_cmd():
    d = ENTRY_REMOTE_DIR
    return (f"install -m 644 {d}/host/sysctl.conf /etc/sysctl.d/99-styx.conf && "
            f"(sysctl -q --system >/dev/null 2>&1 || true) && "
            f"nft -c -f {d}/host/nftables.nft && "
            f"install -D -m 644 {d}/host/nftables.nft /etc/nftables.d/styx.nft && "
            f"nft -f /etc/nftables.d/styx.nft")


def wait_for_cert(cfg, timeout=180):
    cert, key = caddy_cert_paths(cfg["hy_host"])
    host_cert = CADDY_DATA / cert.removeprefix("/caddy/")
    host_key = CADDY_DATA / key.removeprefix("/caddy/")
    import time
    deadline = time.time() + timeout
    while time.time() < deadline:
        if host_cert.exists() and host_key.exists():
            return host_cert, host_key
        time.sleep(5)
    return None, None


def manifest_path(node):
    return STATE / f"deployed-{node}.json"


def deploy(cfg, users, only=None):
    if os.geteuid() != 0:
        die("deploy нужно запускать от root (sudo ./styxctl deploy)")
    tmp = render(cfg, users)
    try:
        xray_test(cfg, tmp / "exit" / "xray" / "config.json", tmp / "exit" / "geo")
        xray_test(cfg, tmp / "entry" / "xray" / "config.json", tmp / "entry" / "geo")
        xray_test(cfg, tmp / "exit" / "probe" / "xray.json", tmp / "exit" / "geo")
        info("xray -test: все конфиги валидны")

        for node in ("exit", "entry"):
            new_hashes = tree_hashes(tmp / node)
            old_hashes = load_json(manifest_path(node), {})
            dst = BUILD / node
            shutil.rmtree(dst, ignore_errors=True)
            dst.parent.mkdir(parents=True, exist_ok=True)
            shutil.move(str(tmp / node), dst)
            if only and node != only:
                continue
            changed, services = changed_services(node, old_hashes, new_hashes)
            if node == "exit":
                deploy_exit(cfg, dst, changed, services)
            else:
                deploy_entry(cfg, dst, changed, services)
            save_json(manifest_path(node), new_hashes)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)
    info("деплой завершён")


def deploy_exit(cfg, node_dir, changed, services):
    info(f"US/exit: изменено файлов: {len(changed)}")
    if any(f.startswith("host/") for f in changed):
        apply_host_local(node_dir)
        info("US/exit: sysctl и firewall применены")
    CADDY_DATA.mkdir(parents=True, exist_ok=True)
    compose(node_dir, "up", "-d", "--build", "--remove-orphans")
    if services:
        compose(node_dir, "restart", *sorted(services))
        info(f"US/exit: перезапущены: {', '.join(sorted(services))}")


def deploy_entry(cfg, node_dir, changed, services):
    info(f"RU/entry: изменено файлов: {len(changed)}")
    cert, key = wait_for_cert(cfg)
    if cert:
        tls = node_dir / "hysteria" / "tls"
        tls.mkdir(parents=True, exist_ok=True)
        shutil.copy2(cert, tls / "cert.crt")
        shutil.copy2(key, tls / "cert.key")
        os.chmod(tls / "cert.key", 0o600)
    else:
        warn("сертификат hy-хоста ещё не выпущен Caddy — Hysteria2 на RU-ноде не стартует. "
             "Проверь DNS-записи и запусти ./styxctl deploy ещё раз")
    ssh_run(cfg, f"mkdir -p {ENTRY_REMOTE_DIR}")
    run(["rsync", "-az", "--delete", "-e", " ".join(ssh_base(cfg)[:-1]),
         f"{node_dir}/", f"{cfg['entry_ssh_user']}@{cfg['entry_ip']}:{ENTRY_REMOTE_DIR}/"])
    if any(f.startswith("host/") for f in changed):
        ssh_run(cfg, remote_host_apply_cmd())
        info("RU/entry: sysctl и firewall применены")
    profiles = "--profile mtproto " if cfg["mtproto_enabled"] else ""
    ssh_run(cfg, f"cd {ENTRY_REMOTE_DIR} && docker compose {profiles}up -d --build --remove-orphans")
    if services:
        ssh_run(cfg, f"cd {ENTRY_REMOTE_DIR} && docker compose {profiles}restart {' '.join(sorted(services))}")
        info(f"RU/entry: перезапущены: {', '.join(sorted(services))}")


def cmd_deploy(args):
    deploy(load_config(), load_users(), only=args.only)


def cmd_sync_certs(args):
    """Copy the renewed hy-host certificate to the entry node (Hysteria re-reads it per handshake)."""
    cfg = load_config()
    cert, key = wait_for_cert(cfg, timeout=1)
    if not cert:
        die("сертификат не найден в state/caddy")
    tls = BUILD / "entry" / "hysteria" / "tls"
    if (tls / "cert.crt").exists() and (tls / "cert.crt").read_bytes() == cert.read_bytes():
        info("сертификат не изменился")
        return
    tls.mkdir(parents=True, exist_ok=True)
    shutil.copy2(cert, tls / "cert.crt")
    shutil.copy2(key, tls / "cert.key")
    run(["rsync", "-az", "-e", " ".join(ssh_base(cfg)[:-1]), f"{tls}/",
         f"{cfg['entry_ssh_user']}@{cfg['entry_ip']}:{ENTRY_REMOTE_DIR}/hysteria/tls/"])
    info("сертификат обновлён на RU-ноде")


def cmd_geo_update(args):
    GEO_DIR.mkdir(parents=True, exist_ok=True)
    for name, url in GEO_URLS.items():
        info(f"скачиваю {name}")
        tmp = GEO_DIR / f"{name}.tmp"
        with urllib.request.urlopen(url, timeout=60) as r:
            tmp.write_bytes(r.read())
        if tmp.stat().st_size < 100_000:
            die(f"{name}: подозрительно маленький файл, не обновляю")
        tmp.replace(GEO_DIR / name)
