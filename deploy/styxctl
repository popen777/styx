def prom_query(q):
    url = "http://127.0.0.1:9090/api/v1/query?" + urllib.parse.urlencode({"query": q})
    with urllib.request.urlopen(url, timeout=10) as r:
        return json.loads(r.read())["data"]["result"]


def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1024:
            return f"{n:.1f} {unit}"
        n /= 1024
    return f"{n:.1f} PB"


def cmd_status(args):
    users = load_users()
    try:
        online = prom_query('styx_user_online{user!~"probe|bridge"}')
        traffic = prom_query('sum by (user) (increase(styx_user_traffic_bytes_total'
                             '{user!~"probe|bridge"}[24h]))')
        probes = prom_query('probe_success{job="chain"}')
        links = prom_query('styx_outbound_alive')
        delays = prom_query('styx_outbound_delay_ms')
    except Exception as e:
        die(f"Prometheus недоступен на 127.0.0.1:9090: {e}")

    cols = [("entry", "vless"), ("entry", "hy2"), ("exit", "vless"), ("exit", "hy2")]
    table = {u["name"]: {c: 0 for c in cols} for u in users}
    for r in online:
        m = r["metric"]
        table.setdefault(m["user"], {c: 0 for c in cols})[(m["node"], m["proto"])] = int(float(r["value"][1]))
    tr = {r["metric"]["user"]: float(r["value"][1]) for r in traffic}

    print("\nУстройства онлайн (VLESS = уникальные IP, HY2 = клиенты):\n")
    print(f"{'пользователь':<20} {'RU·VLESS':>9} {'RU·HY2':>8} {'US·VLESS':>9} {'US·HY2':>8} {'24ч':>11}")
    total = 0
    for name in sorted(table):
        row = table[name]
        s = sum(row.values())
        total += s
        mark = "●" if s else " "
        print(f"{mark} {name:<18} " + " ".join(f"{row[c]:>{w}}" for c, w in zip(cols, (9, 8, 9, 8)))
              + f" {human(tr.get(name, 0)):>11}")
    active = sum(1 for r in table.values() if sum(r.values()))
    print(f"\nактивных пользователей: {active} / {len(users)}, устройств: {total}")

    print("\nЦепочки (проверка с US-ноды):")
    for r in sorted(probes, key=lambda r: r["metric"].get("path", "")):
        ok = r["value"][1] == "1"
        print(f"  {'✅' if ok else '❌'} {r['metric'].get('path', r['metric'].get('instance'))}")
    print("\nКаналы RU → US (observatory на RU-ноде):")
    dl = {r["metric"]["tag"]: float(r["value"][1]) for r in delays}
    for r in sorted(links, key=lambda r: r["metric"]["tag"]):
        tag = r["metric"]["tag"]
        ok = r["value"][1] == "1"
        print(f"  {'✅' if ok else '❌'} {tag:<10} {dl.get(tag, 0):.0f} ms")
    print()


# ---------------------------------------------------------------- main

def main():
    p = argparse.ArgumentParser(prog="styxctl", description="Styx 2 control tool")
    sub = p.add_subparsers(dest="cmd", required=True)

    sp = sub.add_parser("init", help="первичная настройка и генерация секретов")
    sp.add_argument("--force", action="store_true")
    sp.set_defaults(func=cmd_init)

    up = sub.add_parser("user", help="управление клиентами")
    usub = up.add_subparsers(dest="ucmd", required=True)
    a = usub.add_parser("add", help="добавить клиента")
    a.add_argument("name")
    a.add_argument("--note", default="")
    a.add_argument("--no-deploy", action="store_true")
    a.set_defaults(func=cmd_user_add)
    for name, fn, hlp in (("del", cmd_user_del, "удалить клиента"),
                          ("disable", lambda x: cmd_user_toggle(x, False), "временно отключить"),
                          ("enable", lambda x: cmd_user_toggle(x, True), "включить обратно"),
                          ("rotate", cmd_user_rotate, "перевыпустить ключи и ссылку")):
        x = usub.add_parser(name, help=hlp)
        x.add_argument("name")
        x.add_argument("--no-deploy", action="store_true")
        x.set_defaults(func=fn)
    x = usub.add_parser("show", help="показать ссылки и QR")
    x.add_argument("name")
    x.set_defaults(func=cmd_user_show)
    x = usub.add_parser("list", help="список клиентов")
    x.set_defaults(func=cmd_user_list)

    sp = sub.add_parser("mtproto", help="MTProto-прокси для Telegram на RU-ноде")
    sp.add_argument("action", choices=["enable", "disable", "show"])
    sp.add_argument("--domain", help="FakeTLS-домен (из белого списка)")
    sp.add_argument("--port", type=int)
    sp.add_argument("--no-deploy", action="store_true")
    sp.set_defaults(func=cmd_mtproto)

    sp = sub.add_parser("render", help="только отрендерить конфиги в build/")
    sp.set_defaults(func=cmd_render)
    sp = sub.add_parser("deploy", help="отрендерить и задеплоить на обе ноды")
    sp.add_argument("--only", choices=["exit", "entry"])
    sp.set_defaults(func=cmd_deploy)
    sp = sub.add_parser("status", help="кто онлайн, состояние цепочек")
    sp.set_defaults(func=cmd_status)
    sp = sub.add_parser("geo-update", help="обновить geoip/geosite (runetfreedom)")
    sp.add_argument("--deploy", action="store_true")
    sp.set_defaults(func=cmd_geo_update)
    sp = sub.add_parser("sync-certs", help="скопировать обновлённый TLS-сертификат на RU-ноду")
    sp.set_defaults(func=cmd_sync_certs)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
