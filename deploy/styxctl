def read_routing(name):
    return (ROOT / "routing" / name).read_text()


def render_subscriptions(cfg, users, out_dir):
    happ_routing = b64(read_routing("happ.json"))
    for u in users:
        if not u["enabled"]:
            continue
        links = "\n".join(client_links(cfg, u))
        (out_dir / f"{u['token']}.txt").write_text(b64(links))
        (out_dir / f"{u['token']}.happ").write_text(
            b64(f"happ://routing/onadd/{happ_routing}\n{links}"))
    (out_dir / "index.html").write_text("")


def write(path, content, mode=0o644):
    path.parent.mkdir(parents=True, exist_ok=True)
    if isinstance(content, (dict, list)):
        content = json.dumps(content, indent=2, ensure_ascii=False) + "\n"
    path.write_text(content)
    os.chmod(path, mode)


def copy_tree(src, dst):
    shutil.copytree(src, dst, dirs_exist_ok=True,
                    ignore=shutil.ignore_patterns("__pycache__", "*.pyc"))


def tpl_values(cfg):
    s = cfg["secrets"]
    hop_start, hop_end = cfg["hop_range"].split("-")
    im = cfg["images"]
    return {
        "SERVER_NAME": cfg["server_name"],
        "SERVER_NAME_B64": b64(cfg["server_name"]),
        "SUB_HOST": cfg["sub_host"], "HY_HOST": cfg["hy_host"], "SUB_PORT": cfg["sub_port"],
        "ACME_EMAIL": cfg["acme_email"],
        "EXIT_IP": cfg["exit_ip"], "ENTRY_IP": cfg["entry_ip"],
        "EXIT_SSH_PORT": cfg["exit_ssh_port"], "ENTRY_SSH_PORT": cfg["entry_ssh_port"],
        "BRIDGE_PORT": cfg["bridge_port"],
        "HOP_START": hop_start, "HOP_END": hop_end,
        "TELEGRAM_BOT_TOKEN": cfg["telegram_bot_token"],
        "TELEGRAM_CHAT_ID": cfg["telegram_chat_id"],
        "DEADMAN_BLOCK": (f'    webhook_configs:\n      - url: "{cfg["deadman_url"]}"\n        send_resolved: false'
                          if cfg["deadman_url"] else "    # dead man's switch disabled (deadman_url is empty)"),
        "V2RAYTUN_ROUTING_B64": b64(read_routing("v2raytun.json")),
        "GRAFANA_PASSWORD": s["grafana_password"],
        "HY_STATS_SECRET": s["hy_stats_secret"],
        "MTPROTO_PORT": cfg["mtproto_port"],
        "MTPROTO_SECRET": s.get("mtproto_secret", ""),
        "IMG_XRAY": im["xray"], "IMG_HYSTERIA": im["hysteria"], "IMG_CADDY": im["caddy"],
        "IMG_PROMETHEUS": im["prometheus"], "IMG_ALERTMANAGER": im["alertmanager"],
        "IMG_BLACKBOX": im["blackbox"], "IMG_NODE_EXPORTER": im["node_exporter"],
        "IMG_GRAFANA": im["grafana"], "IMG_MTG": im["mtg"],
    }


def render_templates(src_dir, dst_dir, values):
    """Copy a node template dir; files ending in .tpl are rendered and lose the suffix."""
    for src in sorted(src_dir.rglob("*")):
        if src.is_dir():
            continue
        rel = src.relative_to(src_dir)
        if src.suffix == ".tpl":
            write(dst_dir / str(rel)[:-4], tpl(src.read_text(), values))
        else:
            (dst_dir / rel).parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(src, dst_dir / rel)


def render_host(dst, role, values):
    write(dst / "sysctl.conf", (ROOT / "host" / "sysctl.conf").read_text())
    write(dst / "nftables.nft", tpl((ROOT / "host" / f"{role}.nft.tpl").read_text(), values))


def render(cfg, users):
    """Render both nodes into a fresh temp dir and return it."""
    tmp = Path(tempfile.mkdtemp(prefix="styx-build-", dir=STATE))
    values = tpl_values(cfg)
    s = cfg["secrets"]

    # ---- exit
    ex = tmp / "exit"
    render_templates(ROOT / "exit", ex, values)
    render_host(ex / "host", "exit", values)
    copy_tree(ROOT / "exporter", ex / "exporter")
    write(ex / "xray" / "config.json", exit_xray(cfg, users))
    cert, key = caddy_cert_paths(cfg["hy_host"])
    write(ex / "hysteria" / "config.json",
          hy_server(cfg, users, s["exit_obfs"],
                    {"probe": s["probe_hy_password"], "bridge": s["bridge_hy_password"]},
                    cert, key, socks_outbound=False), 0o600)
    write(ex / "probe" / "xray.json", probe_xray(cfg))
    write(ex / "probe" / "hy-entry.json",
          hy_client(cfg, f"{cfg['entry_ip']}:443", f"probe:{s['probe_hy_password']}",
                    s["entry_obfs"], "http", "127.0.0.1:18083"), 0o600)
    write(ex / "probe" / "hy-exit.json",
          hy_client(cfg, f"{cfg['exit_ip']}:443", f"probe:{s['probe_hy_password']}",
                    s["exit_obfs"], "http", "127.0.0.1:18084"), 0o600)
    (ex / "sub").mkdir(parents=True, exist_ok=True)
    render_subscriptions(cfg, users, ex / "sub")
    copy_geo(ex / "geo")

    # ---- entry
    en = tmp / "entry"
    render_templates(ROOT / "entry", en, values)
    render_host(en / "host", "entry", dict(values, MTPROTO_RULE=(
        f"tcp dport {cfg['mtproto_port']} accept comment \"mtproto\"" if cfg["mtproto_enabled"] else "")))
    copy_tree(ROOT / "exporter", en / "exporter")
    write(en / "xray" / "config.json", entry_xray(cfg, users))
    write(en / "hysteria" / "server.json",
          hy_server(cfg, users, s["entry_obfs"], {"probe": s["probe_hy_password"]},
                    "/etc/hysteria/tls/cert.crt", "/etc/hysteria/tls/cert.key",
                    socks_outbound=True), 0o600)
    write(en / "hysteria" / "bridge.json",
          hy_client(cfg, f"{cfg['exit_ip']}:{cfg['hop_range']}", f"bridge:{s['bridge_hy_password']}",
                    s["exit_obfs"], "socks5", "127.0.0.1:10809"), 0o600)
    copy_geo(en / "geo")
    if not cfg["mtproto_enabled"]:
        shutil.rmtree(en / "mtg", ignore_errors=True)
    return tmp


def copy_geo(dst):
    dst.mkdir(parents=True, exist_ok=True)
    for name in GEO_URLS:
        src = GEO_DIR / name
        if not src.exists():
            die(f"нет {src} — запусти ./styxctl geo-update")
        shutil.copy2(src, dst / name)


def tree_hashes(root):
    out = {}
    if not root.exists():
        return out
    for p in sorted(root.rglob("*")):
        if p.is_file():
            out[str(p.relative_to(root))] = hashlib.sha256(p.read_bytes()).hexdigest()
    return out


def changed_services(node, old, new):
    changed = {f for f in set(old) | set(new) if old.get(f) != new.get(f)}
    services = set()
    for f in changed:
        for prefix, svcs in RESTART_MAP[node].items():
            if f.startswith(prefix):
                services.update(svcs)
    return changed, services


def cmd_render(args):
    cfg = load_config()
    tmp = render(cfg, load_users())
    for node in ("exit", "entry"):
        dst = BUILD / node
