# ---------------------------------------------------------------- helpers

def info(msg):
    print(f"\033[0;32m[+]\033[0m {msg}")


def warn(msg):
    print(f"\033[1;33m[!]\033[0m {msg}")


def die(msg):
    print(f"\033[0;31m[x]\033[0m {msg}", file=sys.stderr)
    sys.exit(1)


def run(cmd, check=True, capture=False, input_bytes=None):
    res = subprocess.run(cmd, check=False, capture_output=capture, input=input_bytes)
    if check and res.returncode != 0:
        err = res.stderr.decode(errors="replace") if capture and res.stderr else ""
        die(f"command failed ({res.returncode}): {' '.join(map(str, cmd))}\n{err}")
    return res


def b64(data):
    if isinstance(data, str):
        data = data.encode()
    return base64.b64encode(data).decode()


def b64url_raw(data):
    return base64.urlsafe_b64encode(data).decode().rstrip("=")


def x25519_keypair():
    """Reality keypair via openssl: raw 32-byte keys are the DER tails."""
    priv_der = run(["openssl", "genpkey", "-algorithm", "X25519", "-outform", "DER"],
                   capture=True).stdout
    pub_der = run(["openssl", "pkey", "-inform", "DER", "-pubout", "-outform", "DER"],
                  capture=True, input_bytes=priv_der).stdout
    return b64url_raw(priv_der[-32:]), b64url_raw(pub_der[-32:])


def password(nbytes=18):
    return secrets.token_urlsafe(nbytes)


def load_json(path, default=None):
    if not path.exists():
        return default
    return json.loads(path.read_text())


def save_json(path, data, mode=0o600):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(".tmp")
    tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n")
    os.chmod(tmp, mode)
    tmp.replace(path)


def load_config():
    cfg = load_json(CONFIG_FILE)
    if cfg is None:
        die("state/config.json not found — run: ./styxctl init")
    merged = json.loads(json.dumps(DEFAULTS))
    merged.update({k: v for k, v in cfg.items() if k != "images"})
    merged["images"].update(cfg.get("images", {}))
    return merged


def load_users():
    return load_json(USERS_FILE, [])


def save_users(users):
    save_json(USERS_FILE, users)


def ask(prompt, default=None, required=True):
    suffix = f" [{default}]" if default not in (None, "") else ""
    while True:
        val = input(f"{prompt}{suffix}: ").strip()
        if not val and default is not None:
            return default
        if val or not required:
            return val
        print("  значение обязательно")


def detect_public_ip():
    for url in ("https://api.ipify.org", "https://ifconfig.me/ip"):
        try:
            with urllib.request.urlopen(url, timeout=5) as r:
                ip = r.read().decode().strip()
                if re.fullmatch(r"\d+\.\d+\.\d+\.\d+", ip):
                    return ip
        except Exception:
            pass
    return None


def tpl(text, values):
    """Replace @@KEY@@ tokens; fail loudly on leftovers."""
    for k, v in values.items():
        text = text.replace(f"@@{k}@@", str(v))
    left = re.findall(r"@@[A-Z0-9_]+@@", text)
    if left:
        die(f"unrendered template tokens: {sorted(set(left))}")
    return text


def sanitize_name(name):
    name = name.strip().lower().replace(" ", "-")
    if not re.fullmatch(r"[a-z0-9][a-z0-9_.-]{0,31}", name):
        die("имя: латиница/цифры/._- , до 32 символов (например: ivan, masha-phone)")
    if name in SYSTEM_USERS:
        die(f"имя '{name}' зарезервировано")
    return name


# ---------------------------------------------------------------- init

def cmd_init(args):
    if CONFIG_FILE.exists() and not args.force:
        die("state/config.json уже существует (используй --force для перегенерации — "
            "все клиентские ссылки станут недействительными)")

    print("\n=== Styx 2 — первичная настройка (запускать на US/exit ноде) ===\n")
    cfg = {}
    cfg["server_name"] = ask("Название VPN (видно в клиентах)", DEFAULTS["server_name"])
    domain = ask("Базовый домен (например example.com)")
    cfg["sub_host"] = ask("Хост для подписок и Grafana (A-запись → US IP)", f"sub.{domain}")
    cfg["hy_host"] = ask("Хост для сертификата Hysteria2 (A-запись → US IP)", f"hy.{domain}")
    cfg["acme_email"] = ask("Email для Let's Encrypt", f"admin@{domain}")
    cfg["sub_port"] = int(ask("TCP-порт HTTPS подписок", DEFAULTS["sub_port"]))

    cfg["exit_ip"] = ask("Публичный IPv4 US-ноды (exit)", detect_public_ip())
    cfg["exit_ssh_port"] = int(ask("SSH-порт US-ноды", DEFAULTS["exit_ssh_port"]))
    cfg["entry_ip"] = ask("Публичный IPv4 RU-ноды (entry, белый список)")
    cfg["entry_ssh_port"] = int(ask("SSH-порт RU-ноды", DEFAULTS["entry_ssh_port"]))
    cfg["entry_ssh_user"] = ask("SSH-пользователь RU-ноды", DEFAULTS["entry_ssh_user"])

    print("\nReality SNI: сайт с TLS 1.3 + H2, лучше в той же подсети/ASN, что и сервер.")
    print("Подбор: RealiTLScanner по соседним IP (см. deploy/README.md).")
    cfg["exit_reality_sni"] = ask("Reality SNI для US-ноды (например www.example-neighbour.com)")
    cfg["entry_reality_sni"] = ask("Reality SNI для RU-ноды (домен ИЗ БЕЛОГО СПИСКА, напр. в той же облачной сети)")

    cfg["hop_range"] = ask("Диапазон UDP port hopping", DEFAULTS["hop_range"])
    cfg["bridge_port"] = int(ask("TCP-порт межсерверного туннеля XHTTP (открыт только для RU IP)",
                                 DEFAULTS["bridge_port"]))

    print("\nАлерты в Telegram (бот от @BotFather, chat_id — твой id или id группы).")
    cfg["telegram_bot_token"] = ask("Telegram bot token")
    cfg["telegram_chat_id"] = ask("Telegram chat_id")
    cfg["deadman_url"] = ask("Dead man's switch URL (healthchecks.io, Enter — пропустить)",
                             "", required=False)

    mt = ask("Включить MTProto-прокси для Telegram на RU-ноде? (y/N)", "n", required=False)
    cfg["mtproto_enabled"] = mt.lower().startswith("y")
    if cfg["mtproto_enabled"]:
        cfg["mtproto_port"] = int(ask("Порт MTProto", DEFAULTS["mtproto_port"]))
        cfg["mtproto_domain"] = ask("FakeTLS-домен для MTProto (из белого списка)",
                                    cfg["entry_reality_sni"])

    info("Генерирую ключи и секреты...")
    exit_priv, exit_pub = x25519_keypair()
    entry_priv, entry_pub = x25519_keypair()
    cfg["secrets"] = {
        "exit_reality_private": exit_priv,
        "exit_reality_public": exit_pub,
        "entry_reality_private": entry_priv,
        "entry_reality_public": entry_pub,
        "exit_short_id": secrets.token_hex(8),
        "entry_short_id": secrets.token_hex(8),
        "bridge_short_id": secrets.token_hex(8),
        "xhttp_path": "/" + secrets.token_hex(6),
        "exit_obfs": password(24),
        "entry_obfs": password(24),
        "bridge_uuid": str(uuid.uuid4()),
        "bridge_hy_password": password(),
        "probe_uuid": str(uuid.uuid4()),
        "probe_hy_password": password(),
        "hy_stats_secret": password(),
        "grafana_password": password(12),
        "mtproto_secret": "",
    }
    if cfg["mtproto_enabled"]:
        cfg["secrets"]["mtproto_secret"] = mtproto_secret(cfg["mtproto_domain"])

    save_json(CONFIG_FILE, cfg)
    if not USERS_FILE.exists():
        save_users([])

    if not SSH_KEY.exists():
        SSH_KEY.parent.mkdir(parents=True, exist_ok=True)
        run(["ssh-keygen", "-q", "-t", "ed25519", "-N", "", "-C", "styx-control", "-f", str(SSH_KEY)])
    pub = (SSH_KEY.parent / "id_ed25519.pub").read_text().strip()

    info("Готово. state/config.json создан (держи его в секрете и делай бэкап).")
    print("\nДальше:")
    print("  1) На RU-ноде добавь ключ управления в /root/.ssh/authorized_keys:\n")
    print(f"     {pub}\n")
    print("  2) ./styxctl geo-update")
    print("  3) ./styxctl user add <имя>")
    print("  4) ./styxctl deploy")
    print(f"\nGrafana: https://{cfg['sub_host']}:{cfg['sub_port']}/grafana/  "
          f"(admin / {cfg['secrets']['grafana_password']})")


def mtproto_secret(domain):
    """FakeTLS secret: ee + 16 random bytes + hex(domain)."""
    return "ee" + secrets.token_hex(16) + domain.encode().hex()


# ---------------------------------------------------------------- users

def find_user(users, name):
    for u in users:
        if u["name"] == name:
            return u
    die(f"пользователь '{name}' не найден")


def cmd_user_add(args):
    cfg = load_config()
    users = load_users()
    name = sanitize_name(args.name)
    if any(u["name"] == name for u in users):
        die(f"пользователь '{name}' уже есть")
    user = {
        "name": name,
        "uuid": str(uuid.uuid4()),
        "hy_password": password(),
        "token": secrets.token_urlsafe(18),
        "enabled": True,
        "note": args.note or "",
        "created": datetime.date.today().isoformat(),
    }
    users.append(user)
    save_users(users)
    info(f"пользователь '{name}' создан")
    if not args.no_deploy:
        deploy(cfg, users)
    show_user(cfg, user)


def cmd_user_del(args):
    cfg = load_config()
    users = load_users()
    find_user(users, args.name)
    users = [u for u in users if u["name"] != args.name]
    save_users(users)
    info(f"пользователь '{args.name}' удалён")
    if not args.no_deploy:
        deploy(cfg, users)


def cmd_user_toggle(args, enabled):
    cfg = load_config()
    users = load_users()
    find_user(users, args.name)["enabled"] = enabled
    save_users(users)
    info(f"пользователь '{args.name}' {'включён' if enabled else 'отключён'}")
    if not args.no_deploy:
        deploy(cfg, users)


def cmd_user_rotate(args):
    """New credentials + new subscription URL (old link stops working)."""
    cfg = load_config()
    users = load_users()
    u = find_user(users, args.name)
    u["uuid"] = str(uuid.uuid4())
    u["hy_password"] = password()
    u["token"] = secrets.token_urlsafe(18)
    save_users(users)
    if not args.no_deploy:
        deploy(cfg, users)
    show_user(cfg, u)


def cmd_user_list(args):
    users = load_users()
    if not users:
        print("пользователей нет")
        return
    print(f"{'имя':<20} {'статус':<10} {'создан':<12} заметка")
    for u in users:
        st = "активен" if u["enabled"] else "отключён"
        print(f"{u['name']:<20} {st:<10} {u['created']:<12} {u.get('note', '')}")


def cmd_user_show(args):
    cfg = load_config()
    show_user(cfg, find_user(load_users(), args.name))


def sub_url(cfg, user):
    return f"https://{cfg['sub_host']}:{cfg['sub_port']}/s/{user['token']}"


def show_user(cfg, user):
    url = sub_url(cfg, user)
    print("\n" + "=" * 60)
    print(f"  {user['name']}")
    print("=" * 60)
    print(f"\nПодписка (Happ / v2RayTun / Hiddify / Shadowrocket / Throne):\n\n  {url}\n")
    print(f"Happ одним тапом:  happ://add/{url}")
    print(f"v2RayTun:          v2raytun://import/{url}\n")
    if shutil.which("qrencode"):
        subprocess.run(["qrencode", "-t", "ANSIUTF8", "-m", "1", url])
    print("Отдельные ссылки:")
    for line in client_links(cfg, user):
        print(f"  {line}")
    print()


# ---------------------------------------------------------------- links

def frag(name):
    return urllib.parse.quote(name, safe="")


def vless_link(uid, host, port, pbk, sni, sid, fp, name):
    q = urllib.parse.urlencode({
        "type": "tcp", "security": "reality", "encryption": "none",
        "flow": "xtls-rprx-vision", "fp": fp, "pbk": pbk, "sni": sni, "sid": sid,
    })
    return f"vless://{uid}@{host}:{port}?{q}#{frag(name)}"


def hy2_link(user, pw, host, sni, obfs, hop, name):
    auth = urllib.parse.quote(f"{user}:{pw}", safe=":")
    q = urllib.parse.urlencode({
        "sni": sni, "obfs": "salamander", "obfs-password": obfs, "mport": hop,
    })
    return f"hy2://{auth}@{host}:443?{q}#{frag(name)}"


def client_links(cfg, user):
    s = cfg["secrets"]
    fp = cfg["fingerprint"]
    return [
        vless_link(user["uuid"], cfg["entry_ip"], 443, s["entry_reality_public"],
                   cfg["entry_reality_sni"], s["entry_short_id"], fp,
                   "🇷🇺→🇺🇸 RU-вход · VLESS (белые списки)"),
        hy2_link(user["name"], user["hy_password"], cfg["entry_ip"], cfg["hy_host"],
                 s["entry_obfs"], cfg["hop_range"], "🇷🇺→🇺🇸 RU-вход · Hysteria2"),
        vless_link(user["uuid"], cfg["exit_ip"], 443, s["exit_reality_public"],
                   cfg["exit_reality_sni"], s["exit_short_id"], fp,
                   "🇺🇸 США напрямую · VLESS"),
        hy2_link(user["name"], user["hy_password"], cfg["exit_ip"], cfg["hy_host"],
                 s["exit_obfs"], cfg["hop_range"], "🇺🇸 США напрямую · Hysteria2"),
    ]


# ---------------------------------------------------------------- xray configs

def xray_base(cfg):
    return {
        "log": {"loglevel": "warning", "access": "none", "dnsLog": False},
        "api": {"tag": "api", "listen": "127.0.0.1:10085",
                "services": ["StatsService", "HandlerService"]},
        "metrics": {"tag": "metrics", "listen": "127.0.0.1:11111"},
        "stats": {},
        "policy": {
            "levels": {"0": {
                "handshake": 4, "connIdle": 300, "uplinkOnly": 1, "downlinkOnly": 1,
                "statsUserUplink": True, "statsUserDownlink": True, "statsUserOnline": True,
            }},
            "system": {
                "statsInboundUplink": True, "statsInboundDownlink": True,
                "statsOutboundUplink": True, "statsOutboundDownlink": True,
            },
        },
        "dns": {
            "servers": ["https+local://1.1.1.1/dns-query", "https+local://8.8.8.8/dns-query", "localhost"],
            "queryStrategy": "UseIPv4",
        },
    }


def reality_server(sni, private_key, short_ids):
    return {
        "show": False,
        "target": f"{sni}:443",
        "xver": 0,
        "serverNames": [sni],
        "privateKey": private_key,
        "shortIds": short_ids,
    }


SNIFFING = {"enabled": True, "destOverride": ["http", "tls", "quic"], "routeOnly": True}


def vless_clients(users, extra, flow=True):
    out = []
    for u in users:
        if not u["enabled"]:
            continue
        c = {"id": u["uuid"], "email": u["name"]}
        if flow:
            c["flow"] = "xtls-rprx-vision"
        out.append(c)
    for name, uid in extra:
        c = {"id": uid, "email": name}
        if flow:
            c["flow"] = "xtls-rprx-vision"
        out.append(c)
    return out


def exit_xray(cfg, users):
    s = cfg["secrets"]
    conf = xray_base(cfg)
    conf["inbounds"] = [
        {
            "tag": "vless-in", "listen": "0.0.0.0", "port": 443, "protocol": "vless",
            "settings": {"clients": vless_clients(users, [("probe", s["probe_uuid"]),
                                                          ("bridge", s["bridge_uuid"])]),
                         "decryption": "none"},
            "streamSettings": {
                "network": "raw", "security": "reality",
                "realitySettings": reality_server(cfg["exit_reality_sni"], s["exit_reality_private"],
                                                  [s["exit_short_id"], s["bridge_short_id"]]),
                "sockopt": {"tcpFastOpen": True},
            },
            "sniffing": SNIFFING,
        },
        {
            # RU entry -> US tunnel. Firewalled to the entry IP only.
            "tag": "bridge-in", "listen": "0.0.0.0", "port": cfg["bridge_port"], "protocol": "vless",
            "settings": {"clients": [{"id": s["bridge_uuid"], "email": "bridge"}], "decryption": "none"},
            "streamSettings": {
                "network": "xhttp", "security": "reality",
                "xhttpSettings": {"path": s["xhttp_path"], "mode": "auto"},
                "realitySettings": reality_server(cfg["exit_reality_sni"], s["exit_reality_private"],
                                                  [s["bridge_short_id"]]),
            },
            "sniffing": SNIFFING,
        },
    ]
    conf["outbounds"] = [
        {"tag": "direct", "protocol": "freedom",
         "streamSettings": {"sockopt": {"domainStrategy": "UseIPv4v6"}}},
        {"tag": "block", "protocol": "blackhole"},
    ]
    conf["routing"] = {
        "domainStrategy": "IPIfNonMatch",
        "rules": [
            {"type": "field", "protocol": ["bittorrent"], "outboundTag": "block"},
            {"type": "field", "ip": ["geoip:private"], "outboundTag": "block"},
            {"type": "field", "domain": ["geosite:category-ads-all"], "outboundTag": "block"},
        ],
    }
    return conf


def entry_xray(cfg, users):
    s = cfg["secrets"]
    conf = xray_base(cfg)
    conf["inbounds"] = [
        {
            "tag": "vless-in", "listen": "0.0.0.0", "port": 443, "protocol": "vless",
            "settings": {"clients": vless_clients(users, [("probe", s["probe_uuid"])]),
                         "decryption": "none"},
            "streamSettings": {
                "network": "raw", "security": "reality",
                "realitySettings": reality_server(cfg["entry_reality_sni"], s["entry_reality_private"],
                                                  [s["entry_short_id"]]),
                "sockopt": {"tcpFastOpen": True},
            },
            "sniffing": SNIFFING,
        },
        {
            # local hand-off for Hysteria2 server and MTProto: same routing as VLESS
            "tag": "local-socks", "listen": "127.0.0.1", "port": 10808, "protocol": "socks",
            "settings": {"auth": "noauth", "udp": True},
            "sniffing": SNIFFING,
        },
    ]
    bridge_reality = {
        "serverName": cfg["exit_reality_sni"], "fingerprint": cfg["fingerprint"],
        "publicKey": s["exit_reality_public"], "shortId": s["bridge_short_id"],
    }
    conf["outbounds"] = [
        {
            "tag": "us-xhttp", "protocol": "vless",
            "settings": {"vnext": [{"address": cfg["exit_ip"], "port": cfg["bridge_port"],
                                    "users": [{"id": s["bridge_uuid"], "encryption": "none"}]}]},
            "streamSettings": {"network": "xhttp", "security": "reality",
                               "xhttpSettings": {"path": s["xhttp_path"], "mode": "auto"},
                               "realitySettings": bridge_reality},
        },
        {
            "tag": "us-vision", "protocol": "vless",
            "settings": {"vnext": [{"address": cfg["exit_ip"], "port": 443,
                                    "users": [{"id": s["bridge_uuid"], "encryption": "none",
                                               "flow": "xtls-rprx-vision"}]}]},
            "streamSettings": {"network": "raw", "security": "reality",
                               "realitySettings": bridge_reality},
        },
        {
            # Hysteria2 client container (hy-bridge) exposes SOCKS5 here
            "tag": "us-hy2", "protocol": "socks",
            "settings": {"servers": [{"address": "127.0.0.1", "port": 10809}]},
        },
        {"tag": "direct", "protocol": "freedom",
         "streamSettings": {"sockopt": {"domainStrategy": "UseIPv4v6"}}},
        {"tag": "block", "protocol": "blackhole"},
    ]
    conf["burstObservatory"] = {
        "subjectSelector": ["us-"],
        "pingConfig": {"destination": "https://www.gstatic.com/generate_204", "connectivity": "",
                       "interval": "30s", "sampling": 4, "timeout": "6s"},
    }
    conf["routing"] = {
        "domainStrategy": "IPIfNonMatch",
        "balancers": [{"tag": "us", "selector": ["us-"],
                       "strategy": {"type": "leastPing"}, "fallbackTag": "us-xhttp"}],
        "rules": [
            # monitoring from the exit node: probe user may reach local exporters only
            {"type": "field", "user": ["probe"], "ip": ["127.0.0.1"], "port": "9100,9550",
             "outboundTag": "direct"},
            {"type": "field", "protocol": ["bittorrent"], "outboundTag": "block"},
            {"type": "field", "ip": ["geoip:private"], "outboundTag": "block"},
            {"type": "field", "domain": ["geosite:category-ads-all"], "outboundTag": "block"},
            # blocked in RU -> always via US even if the domain looks Russian
            {"type": "field", "domain": ["geosite:ru-blocked"], "balancerTag": "us"},
            {"type": "field", "ip": ["geoip:ru-blocked"], "balancerTag": "us"},
            # Russian services leave from the Russian IP (banks, gosuslugi, marketplaces)
            {"type": "field", "domain": ["geosite:category-ru", "geosite:ru-available-only-inside",
                                         "domain:ru", "domain:su", "domain:xn--p1ai"],
             "outboundTag": "direct"},
            {"type": "field", "ip": ["geoip:ru"], "outboundTag": "direct"},
            {"type": "field", "network": "tcp,udp", "balancerTag": "us"},
        ],
    }
    return conf


def probe_xray(cfg):
    """Client used by blackbox/prometheus on the exit node to test full chains."""
    s = cfg["secrets"]
    fp = cfg["fingerprint"]

    def out(tag, host, pbk, sni, sid):
        return {
            "tag": tag, "protocol": "vless",
            "settings": {"vnext": [{"address": host, "port": 443,
                                    "users": [{"id": s["probe_uuid"], "encryption": "none",
                                               "flow": "xtls-rprx-vision"}]}]},
            "streamSettings": {"network": "raw", "security": "reality",
                               "realitySettings": {"serverName": sni, "fingerprint": fp,
                                                   "publicKey": pbk, "shortId": sid}},
        }

    return {
        "log": {"loglevel": "warning"},
        "inbounds": [
            {"tag": "via-entry", "listen": "127.0.0.1", "port": 18081, "protocol": "http"},
            {"tag": "via-exit", "listen": "127.0.0.1", "port": 18082, "protocol": "http"},
        ],
        "outbounds": [
            out("entry", cfg["entry_ip"], s["entry_reality_public"], cfg["entry_reality_sni"],
                s["entry_short_id"]),
            out("exit", cfg["exit_ip"], s["exit_reality_public"], cfg["exit_reality_sni"],
                s["exit_short_id"]),
        ],
        "routing": {"rules": [
            {"type": "field", "inboundTag": ["via-entry"], "outboundTag": "entry"},
            {"type": "field", "inboundTag": ["via-exit"], "outboundTag": "exit"},
        ]},
    }


