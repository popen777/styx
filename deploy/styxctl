def hy_bandwidth(cfg):
    bw = {}
    if cfg["hy_bandwidth_up"]:
        bw["up"] = cfg["hy_bandwidth_up"]
    if cfg["hy_bandwidth_down"]:
        bw["down"] = cfg["hy_bandwidth_down"]
    return bw


PRIVATE_ACL = [
    "reject(0.0.0.0/8)", "reject(10.0.0.0/8)", "reject(100.64.0.0/10)", "reject(127.0.0.0/8)",
    "reject(169.254.0.0/16)", "reject(172.16.0.0/12)", "reject(192.168.0.0/16)",
    "reject(::1/128)", "reject(fc00::/7)", "reject(fe80::/10)",
]


def hy_server(cfg, users, obfs, extra_users, cert, key, socks_outbound):
    userpass = {u["name"]: u["hy_password"] for u in users if u["enabled"]}
    userpass.update(extra_users)
    conf = {
        "listen": ":443",
        "tls": {"cert": cert, "key": key, "sniGuard": "disable"},
        "obfs": {"type": "salamander", "salamander": {"password": obfs}},
        "auth": {"type": "userpass", "userpass": userpass},
        "quic": {
            "initStreamReceiveWindow": 8388608, "maxStreamReceiveWindow": 8388608,
            "initConnReceiveWindow": 20971520, "maxConnReceiveWindow": 20971520,
            "maxIdleTimeout": "60s", "maxIncomingStreams": 1024,
        },
        "udpIdleTimeout": "60s",
        "sniff": {"enable": True, "timeout": "2s", "rewriteDomain": False},
        "trafficStats": {"listen": "127.0.0.1:9998", "secret": cfg["secrets"]["hy_stats_secret"]},
    }
    bw = hy_bandwidth(cfg)
    if bw:
        conf["bandwidth"] = bw
    if socks_outbound:
        # everything goes to local Xray, which applies the RU-direct / US-balancer routing
        conf["outbounds"] = [{"name": "xray", "type": "socks5",
                              "socks5": {"addr": "127.0.0.1:10808"}}]
    else:
        conf["outbounds"] = [{"name": "direct", "type": "direct", "direct": {"mode": "auto"}}]
        conf["acl"] = {"inline": PRIVATE_ACL + ["direct(all)"]}
    return conf


def hy_client(cfg, server, auth, obfs, listen_key, listen_addr):
    return {
        "server": server,
        "auth": auth,
        "tls": {"sni": cfg["hy_host"]},
        "obfs": {"type": "salamander", "salamander": {"password": obfs}},
        "transport": {"udp": {"minHopInterval": "20s", "maxHopInterval": "50s"}},
        "fastOpen": True,
        "lazy": False,
        listen_key: {"listen": listen_addr},
    }


def caddy_cert_paths(host):
    base = f"/caddy/data/caddy/certificates/acme-v02.api.letsencrypt.org-directory/{host}"
    return f"{base}/{host}.crt", f"{base}/{host}.key"


